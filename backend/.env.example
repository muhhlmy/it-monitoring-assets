PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# Wajib diisi dengan password database deployment ini.
DB_PASSWORD=
DB_NAME=assets_monitoring
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Wajib diisi dengan secret acak minimal 32 karakter.
JWT_SECRET=
# Cost bcrypt untuk password baru/perubahan password (10-14; default 12).
PASSWORD_BCRYPT_ROUNDS=12
# Default aman: hash bcrypt saja. Gunakan verify-plaintext hanya sebagai mode
# transisi eksplisit untuk akun legacy, lalu kembalikan ke disabled setelah rotasi.
PASSWORD_LEGACY_MODE=disabled
# Isi hanya bila API berada di belakang reverse proxy tepercaya. Gunakan IP/CIDR
# exact yang dipisahkan koma; wildcard dan hop-count generik ditolak.
TRUST_PROXY_CIDRS=
# Daftar origin exact, dipisahkan koma. Wildcard (*) ditolak.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Konfigurasi Notifikasi Email (SMTP)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="IT Support <no-reply@it-monitoring.local>"
